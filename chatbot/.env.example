PORT=5001

# Where the Node/Express ERP API lives. The MCP server subprocess inherits this.
#   Docker Compose : http://backend:4000
#   Running by hand: http://localhost:4000
BACKEND_URL=http://localhost:4000

# Path to the MCP server script. Leave unset when the repo layout is intact.
# MCP_SERVER_PATH=../mcp-server/server.py

# Ollama Cloud. Key from ollama.com -> Settings -> API keys.
# For a local Ollama: OLLAMA_HOST=http://localhost:11434, blank key, and a
# model that supports tool calling (e.g. qwen3:8b).
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_THINK=medium

MAX_TOOL_ROUNDS=8
LOG_LEVEL=INFO
